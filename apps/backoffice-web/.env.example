NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Trial data routing is server-only and fail-closed. Keep disabled until the second project is schema-verified.
TRIAL_DATA_ROUTING_ENABLED=false
TRIAL_SUPABASE_URL=
TRIAL_SUPABASE_SERVICE_ROLE_KEY=
DEV_AUTH_USER_ID=
DEV_AUTH_TENANT_ID=
DEV_AUTH_BRANCH_ID=
DEV_AUTH_BRANCH_ROLE=manager
DEV_AUTH_PLATFORM_ROLE=tenant_user
POS_TIMEOUT_ORDER_CREATE_MS=15000
POS_TIMEOUT_PAYMENT_COMPLETE_MS=15000
AUTH_API_TIMEOUT_MS=8000
# Local development may use memory. Production/serverless should use upstash so limits are shared across instances.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_BACKEND_TIMEOUT_MS=2500
RATE_LIMIT_REDIS_PREFIX=sstipos
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AUTH_EMPLOYEE_RATE_LIMIT_MAX=10
AUTH_EMPLOYEE_RATE_LIMIT_WINDOW_MS=60000
# Production baseline: transaction RPCs are authoritative. Direct multi-request fallbacks are emergency compatibility only.
POS_FORCE_DIRECT_CREATE_NON_DELIVERY=false
POS_FORCE_DIRECT_PAYMENT_COMPLETE=false
POS_SOFT_BYPASS_INSUFFICIENT_STOCK=false
# Development-only feature unlock. Production code ignores these and always enforces subscription gates.
NEXT_PUBLIC_POS_DEV_UNLOCK_ALL_FEATURES=false
POS_DEV_UNLOCK_ALL_FEATURES=false
POS_ORDER_QUEUE_HARD_LIMIT=120
POS_ORDER_QUEUE_STALE_MINUTES=20
POS_PRINT_QUEUE_HARD_LIMIT=250
POS_DEAD_LETTER_WINDOW_MINUTES=60
NEXT_PUBLIC_POS_MONITOR_POLL_MS=30000
NEXT_PUBLIC_PROMPTPAY_PHONE=0843374982
NEXT_PUBLIC_PROMPTPAY_PAYEE_NAME=
INET_NOPS_ENV=uat
INET_NOPS_MERCHANT_KEY_UAT=
INET_NOPS_MERCHANT_ID_UAT=
INET_NOPS_ALLOW_MISSING_MERCHANT_ID_UAT=false
INET_NOPS_OAUTH_URL_UAT=https://new-ops-poc.inet.co.th/uat/oauth/api/v1/oauth-token
INET_NOPS_ACCESS_TOKEN_URL_UAT=https://new-ops-poc.inet.co.th/uat/api/v1/sandbox/payment-transactions/access-token
# Optional comma-separated additional HTTPS hosts accepted when INET returns a dynamic payment creation link.
# The OAuth/access-token endpoint hosts are always trusted automatically.
INET_NOPS_ALLOWED_PAYMENT_HOSTS_UAT=
INET_NOPS_AP_URL_UAT=https://YOUR_DOMAIN/payment/inet/result
INET_NOPS_CALLBACK_PUBLIC_URL=https://YOUR_DOMAIN/api/payments/inet/callback
INET_NOPS_MERCHANT_KEY_PROD=
INET_NOPS_MERCHANT_ID_PROD=
INET_NOPS_OAUTH_URL_PROD=
INET_NOPS_ACCESS_TOKEN_URL_PROD=
INET_NOPS_ALLOWED_PAYMENT_HOSTS_PROD=
INET_NOPS_AP_URL_PROD=
INET_NOPS_CALLBACK_PUBLIC_URL_PROD=
POS_SLIP_VERIFY_MODE=
POS_SLIP_OCR_MODEL=gpt-4.1-mini
POS_SLIP_OCR_MIN_CONFIDENCE=0.6
PRINT_BRIDGE_URL=
PRINT_BLUETOOTH_BRIDGE_URL=
OPENAI_API_KEY=
POS_DEVICE_CODE_COOKIE_NAME=pos_device_code
POS_SESSION_COOKIE_NAME=pos_session_handoff
POS_SESSION_ID_COOKIE_NAME=pos_session_id
POS_SESSION_HANDOFF_SECRET=replace-with-long-random-secret
TABLE_QR_SIGNING_SECRET=replace-with-another-long-random-secret
WINDOWS_RUNTIME_RATE_LIMIT_MAX=60
WINDOWS_RUNTIME_ENABLE_DEMO_STORE_CODE=false
# Set WINDOWS_RUNTIME_ENABLE_DEMO_STORE_CODE=true only in a controlled demo/sales environment.
# Do not use this flag for production customer package activation; production must resolve package policy from IT Backoffice/Supabase.
# POS_SESSION_COOKIE_DOMAIN=.example.com
# POS_SESSION_COOKIE_SECURE=true